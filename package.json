{
  "name": "flight-booking-system",
  "version": "0.0.0",
  "private": true,
  "description": "Flight Search, Booking and Ticketing System (modular monolith)",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps --config .dependency-cruiser.cjs",
    "test": "pnpm --filter api run test",
    "test:integration": "pnpm --filter api run test:integration",
    "test:e2e": "pnpm --filter web run test:e2e",
    "db:migration:generate": "pnpm --filter api run db:migration:generate",
    "db:migration:create": "pnpm --filter api run db:migration:create",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:migrate:revert": "pnpm --filter api run db:migrate:revert",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}

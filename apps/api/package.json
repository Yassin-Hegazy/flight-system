{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typeorm": "pnpm run build && node --env-file-if-exists=.env ./node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "db:migration:generate": "pnpm run typeorm migration:generate",
    "db:migration:create": "node ./node_modules/typeorm/cli.js migration:create",
    "db:migrate": "pnpm run typeorm migration:run",
    "db:migrate:revert": "pnpm run typeorm migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "5.3.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.1",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
